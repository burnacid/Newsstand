# Newsstand production settings. Copy to .env.production and fill in.
# Generate APP_KEY with:
#   docker compose --env-file .env.production -f docker-compose.production.yml run --rm --no-deps --entrypoint php app artisan key:generate --show

APP_NAME=Newsstand
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://news.example.com
APP_TIMEZONE=Europe/Amsterdam
APP_PORT=8080
# Image tag from Docker Hub (burnacid/newsstand); pin e.g. 1.0.0 for predictable upgrades.
NEWSSTAND_IMAGE_TAG=latest

# Your reverse proxy's address (or * if only the proxy can reach the app).
TRUSTED_PROXIES=*

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=newsstand
DB_USERNAME=newsstand
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=10080
# auto: secure cookies only when the request arrives over HTTPS (works over plain HTTP too).
# Set true only if Newsstand is always reached via HTTPS; over HTTP that causes "419 Page Expired".
SESSION_SECURE_COOKIE=auto
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

# Email (digests, password resets, verification).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=newsstand@example.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Newsstand ---
# open: anyone can sign up. closed: only the first account. disabled: no sign-ups at all.
# Add users with:
#   docker compose ... exec -u www-data app php artisan newsstand:user someone@example.com
NEWSSTAND_REGISTRATION=closed
# Identify yourself to the sites you fetch from.
NEWSSTAND_USER_AGENT="Newsstand/1.0 (+https://news.example.com)"
# Refuse feeds on private/LAN addresses (SSRF protection). Set false to allow LAN feeds.
NEWSSTAND_BLOCK_PRIVATE_HOSTS=true
NEWSSTAND_RETENTION_DAYS=90
# Optional, raises NVD rate limits: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Allow alert channels on LAN addresses (self-hosted ntfy/Gotify). Admins can also switch this in the app.
NEWSSTAND_ALERTS_ALLOW_PRIVATE=false
