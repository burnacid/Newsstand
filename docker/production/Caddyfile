{
	frankenphp
	admin off
	# TLS is expected to be handled by your reverse proxy (see README).
	auto_https off
}

{$SERVER_NAME::8080} {
	root * /app/public
	encode zstd br gzip

	# Long-lived caching for fingerprinted build assets.
	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	php_server
}
